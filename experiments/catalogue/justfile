help:
    @just --list

# ranked grouped search; args are the query terms
search *terms:
    node search.js {{terms}}

# distribution of index entries by class/tier
stats:
    node search.js --stats

# rebuild heuristic index from records.json (overwrites catalogue-index.json)
[confirm]
generator:
    node generator.js

# overlay evidence tiers on the index (overwrites catalogue-index.json)
[confirm]
reclassify:
    node classify-evidence.js --write

# spot-check known apps against the reclassified index
validate:
    node validate-evidence.js

# resumable evidence pass (limiter first arg; parallel via --bucket/--nbuckets; hours of network)
[confirm]
evidence *args:
    node evidence-all.js {{args}}

# full-set export (arg = attr count; 27271 = full set; overwrites records.json)
[confirm]
measure n:
    bash measure.sh {{n}}

# serve the browsable catalogue at localhost:8137
viewer:
    node serve.js

# known-apps recall against the pinned set (needs records.json)
recall:
    node recall.js

# heuristic classifier probe vs the QA sample labels
classify-probe:
    node classify.js

# desktop-entry join prototype (needs records.json; fetches package outputs)
[confirm]
join:
    node join.js

# discovery probe: fetch candidate outputs from cache and scan for desktop data
[confirm]
discover *pkgs:
    bash discover.sh {{pkgs}}

# statistical coverage sample (random derivations; network; long at large N)
[confirm]
coverage *args:
    node sample-coverage.js {{args}}

# tier-split sample of app candidates (network; resumable)
[confirm]
tier-sample *args:
    node tier-sample.js {{args}}

# QA sample: generate entries.json
qa-generate:
    node qa/generate.js

# QA sample: assemble sample-v1.md from a labeller score file (arg = file path)
qa-assemble score-file:
    node qa/assemble.js {{score-file}}

# QA sample: precision/recall from sample-v1.md
qa-score:
    node qa/score.js

# nus.5 cli-pool recovery batch (chunked, resumable; network; hours; arg=deadline HH:MM)
[confirm]
recover-cli deadline='07:30':
    bash nus5-batch.sh {{deadline}}