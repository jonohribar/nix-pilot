help:
    @just --list

# ranked grouped search; args are the query terms
search *terms:
    node search.js {{terms}}

# distribution of index entries by class/tier
stats:
    node search.js --stats

# rebuild heuristic index from records.json (overwrites catalogue-index.json)
[confirm]
generator:
    node generator.js

# overlay evidence tiers on the index (overwrites catalogue-index.json)
[confirm]
reclassify:
    node classify-evidence.js --write

# spot-check known apps against the reclassified index
validate:
    node validate-evidence.js

# resumable evidence pass (limiter first arg; parallel via --bucket/--nbuckets; hours of network)
[confirm]
evidence *args:
    node evidence-all.js {{args}}

# full-set export (arg = attr count; 27271 = full set; overwrites records.json)
[confirm]
measure n:
    bash measure.sh {{n}}

# serve the browsable catalogue at localhost:8137
viewer:
    node serve.js