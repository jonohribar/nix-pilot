using Gtk 4.0;

// Software Store — home page (a stack page inside the navigable prototype;
// the window chrome — header bar, search, sidebar — lives in the shell).
Gtk.Box page_home {
    orientation: vertical;
    margin-start: 28;
    margin-end: 28;
    margin-top: 18;
    margin-bottom: 24;

    Gtk.Label hero {
        xalign: 0.0;
        css-classes: [ "title-2" ];
        label: "Explore 22,030 applications and tools";
    }
    Gtk.Label hero_sub {
        xalign: 0.0;
        css-classes: [ "dim-label" ];
        label: "3,074 confirmed applications   ·   1,670 unverified   ·   289 terminal apps   ·   18,667 command-line tools";
    }

    Gtk.Label sec1 { label: "Featured"; css-classes: [ "heading" ]; xalign: 0.0; margin-top: 20; }
    Gtk.FlowBox {
        homogeneous: true;
        max-children-per-line: 3;
        selection-mode: none;
        margin-top: 4;

        Gtk.Button card_gimp {
            css-classes: [ "card", "flat" ];
            valign: start;
            child: Gtk.Box {
                orientation: vertical;
                Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;
                    Gtk.Box {
                        css-classes: [ "app-icon", "class-app" ];
                        halign: start;
                        valign: center;
                        Gtk.Image { icon-name: "applications-graphics-symbolic"; pixel-size: 26; }
                    }
                    Gtk.Box {
                        orientation: vertical;
                        valign: center;
                        Gtk.Label { label: "GIMP"; css-classes: [ "title" ]; xalign: 0.0; }
                        Gtk.Label { label: "Application"; css-classes: [ "caption", "class-app" ]; xalign: 0.0; }
                    }
                }
                Gtk.Label { label: "GNU Image Manipulation Program — image editor"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
            };
        }

        Gtk.Button card_firefox {
            css-classes: [ "card", "flat" ];
            valign: start;
            child: Gtk.Box {
                orientation: vertical;
                Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;
                    Gtk.Box {
                        css-classes: [ "app-icon", "class-app" ];
                        halign: start;
                        valign: center;
                        Gtk.Image { icon-name: "applications-internet-symbolic"; pixel-size: 26; }
                    }
                    Gtk.Box {
                        orientation: vertical;
                        valign: center;
                        Gtk.Label { label: "Firefox"; css-classes: [ "title" ]; xalign: 0.0; }
                        Gtk.Label { label: "Application"; css-classes: [ "caption", "class-app" ]; xalign: 0.0; }
                    }
                }
                Gtk.Label { label: "Web browser built from the Firefox source tree"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
            };
        }

        Gtk.Button card_webssh {
            css-classes: [ "card", "flat" ];
            valign: start;
            child: Gtk.Box {
                orientation: vertical;
                Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;
                    Gtk.Box {
                        css-classes: [ "app-icon", "class-unverified" ];
                        halign: start;
                        valign: center;
                        Gtk.Image { icon-name: "applications-science-symbolic"; pixel-size: 26; }
                    }
                    Gtk.Box {
                        orientation: vertical;
                        valign: center;
                        Gtk.Label { label: "WebSSH"; css-classes: [ "title" ]; xalign: 0.0; }
                        Gtk.Label { label: "Unverified application"; css-classes: [ "caption", "class-unverified" ]; xalign: 0.0; }
                    }
                }
                Gtk.Label { label: "Web based SSH client — no desktop entry confirmed"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
            };
        }

        Gtk.Button card_vlc {
            css-classes: [ "card", "flat" ];
            valign: start;
            child: Gtk.Box {
                orientation: vertical;
                Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;
                    Gtk.Box {
                        css-classes: [ "app-icon", "class-app" ];
                        halign: start;
                        valign: center;
                        Gtk.Image { icon-name: "multimedia-player-symbolic"; pixel-size: 26; }
                    }
                    Gtk.Box {
                        orientation: vertical;
                        valign: center;
                        Gtk.Label { label: "VLC"; css-classes: [ "title" ]; xalign: 0.0; }
                        Gtk.Label { label: "Application"; css-classes: [ "caption", "class-app" ]; xalign: 0.0; }
                    }
                }
                Gtk.Label { label: "Media player — plays everything"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
            };
        }
    }

    Gtk.Label sec2 { label: "Terminal apps"; css-classes: [ "heading" ]; xalign: 0.0; margin-top: 22; }
    Gtk.Label sec2_sub { label: "Interactive terminal programs — never shown as app tiles"; css-classes: [ "dim-label" ]; xalign: 0.0; }
    Gtk.FlowBox {
        homogeneous: true;
        max-children-per-line: 3;
        selection-mode: none;
        margin-top: 4;

        Gtk.Button card_bork {
            css-classes: [ "card", "flat" ];
            valign: start;
            child: Gtk.Box {
                orientation: vertical;
                Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;
                    Gtk.Box {
                        css-classes: [ "app-icon", "class-term" ];
                        halign: start;
                        valign: center;
                        Gtk.Image { icon-name: "utilities-terminal-symbolic"; pixel-size: 26; }
                    }
                    Gtk.Box {
                        orientation: vertical;
                        valign: center;
                        Gtk.Label { label: "Bork"; css-classes: [ "title" ]; xalign: 0.0; }
                        Gtk.Label { label: "Terminal app"; css-classes: [ "caption", "class-term" ]; xalign: 0.0; }
                    }
                }
                Gtk.Label { label: "TUI chat client for livecoding on Twitch"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
            };
        }

        Gtk.Button card_astroterm {
            css-classes: [ "card", "flat" ];
            valign: start;
            child: Gtk.Box {
                orientation: vertical;
                Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;
                    Gtk.Box {
                        css-classes: [ "app-icon", "class-term" ];
                        halign: start;
                        valign: center;
                        Gtk.Image { icon-name: "utilities-terminal-symbolic"; pixel-size: 26; }
                    }
                    Gtk.Box {
                        orientation: vertical;
                        valign: center;
                        Gtk.Label { label: "Astroterm"; css-classes: [ "title" ]; xalign: 0.0; }
                        Gtk.Label { label: "Terminal app"; css-classes: [ "caption", "class-term" ]; xalign: 0.0; }
                    }
                }
                Gtk.Label { label: "Celestial viewer for the terminal"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
            };
        }
    }
}
