using Gtk 4.0;
using Adw 1;

// nix-pilot wireframe — Software Store: search results, grouped by class
// Demonstrates D16 (CLI never an app tile) and D18 (unverified group).
Adw.ApplicationWindow window {
    default-width: 1180;
    default-height: 840;
    title: "nix-pilot — Software Store";

    content: Gtk.Box {
        orientation: vertical;

        Adw.HeaderBar {
            title-widget: Gtk.Label { label: "Software"; css-classes: [ "title" ]; };
            Gtk.SearchEntry {
                hexpand: true;
                margin-start: 28;
                margin-end: 28;
                text: "docker";
            }
        }

        Gtk.Box body {
            orientation: horizontal;

            Gtk.Box sidebar {
                orientation: vertical;
                width-request: 236;
                css-classes: [ "nav" ];
                Gtk.Label { label: "CATEGORIES"; css-classes: [ "nav-title" ]; margin-top: 14; margin-start: 14; margin-bottom: 4; }
                Gtk.Button { label: "Home"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Applications"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Unverified"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Terminal apps"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Command-line tools"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Separator { margin-top: 10; margin-bottom: 10; }
                Gtk.Button { label: "Updates"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Settings"; css-classes: [ "flat", "nav-item" ]; }
            }

            Gtk.ScrolledWindow {
                vexpand: true;
                hexpand: true;
                Gtk.Box main {
                    orientation: vertical;
                    margin-start: 28;
                    margin-end: 28;
                    margin-top: 14;

                    Gtk.Label q { xalign: 0.0; css-classes: [ "title-2" ]; label: "Results for “docker”"; }
                    Gtk.Label q_sub { xalign: 0.0; css-classes: [ "dim-label" ]; label: "4 matches · grouped by class — command-line tools are never shown as app tiles"; }

                    // ---- CLI group first (that is where docker belongs, D16)
                    Gtk.Label g1 { label: "COMMAND-LINE TOOLS"; css-classes: [ "group-header" ]; }
                    Gtk.Box r1 { css-classes: [ "result-row" ]; orientation: horizontal; spacing: 14;
                        Gtk.Box { css-classes: [ "app-icon", "class-cli" ]; halign: start; valign: center;
                            Gtk.Image { icon-name: "utilities-terminal-symbolic"; pixel-size: 24; }
                        }
                        Gtk.Box { orientation: vertical; valign: center;
                            Gtk.Label { label: "docker"; css-classes: [ "title" ]; xalign: 0.0; }
                            Gtk.Label { label: "Pack, ship and run any application as a lightweight container"; css-classes: [ "desc" ]; xalign: 0.0; }
                        }
                    }
                    Gtk.Box r2 { css-classes: [ "result-row" ]; orientation: horizontal; spacing: 14;
                        Gtk.Box { css-classes: [ "app-icon", "class-cli" ]; halign: start; valign: center;
                            Gtk.Image { icon-name: "utilities-terminal-symbolic"; pixel-size: 24; }
                        }
                        Gtk.Box { orientation: vertical; valign: center;
                            Gtk.Label { label: "docker-buildx"; css-classes: [ "title" ]; xalign: 0.0; }
                            Gtk.Label { label: "Docker CLI plugin for extended build capabilities"; css-classes: [ "desc" ]; xalign: 0.0; }
                        }
                    }
                    Gtk.Box r3 { css-classes: [ "result-row" ]; orientation: horizontal; spacing: 14;
                        Gtk.Box { css-classes: [ "app-icon", "class-cli" ]; halign: start; valign: center;
                            Gtk.Image { icon-name: "utilities-terminal-symbolic"; pixel-size: 24; }
                        }
                        Gtk.Box { orientation: vertical; valign: center;
                            Gtk.Label { label: "docker-compose"; css-classes: [ "title" ]; xalign: 0.0; }
                            Gtk.Label { label: "Define and run multi-container applications"; css-classes: [ "desc" ]; xalign: 0.0; }
                        }
                    }

                    // ---- an application result, clearly separated (D18 unverified shown as its own group)
                    Gtk.Label g2 { label: "UNVERIFIED APPLICATION"; css-classes: [ "group-header" ]; }
                    Gtk.Box r4 { css-classes: [ "result-row" ]; orientation: horizontal; spacing: 14;
                        Gtk.Box { css-classes: [ "app-icon", "class-unverified" ]; halign: start; valign: center;
                            Gtk.Image { icon-name: "applications-science-symbolic"; pixel-size: 24; }
                        }
                        Gtk.Box { orientation: vertical; valign: center;
                            Gtk.Label { label: "dockstation"; css-classes: [ "title" ]; xalign: 0.0; }
                            Gtk.Label { label: "Docker management UI — no desktop entry confirmed yet"; css-classes: [ "desc" ]; xalign: 0.0; }
                        }
                    }
                }
            }
        }
    };
}
