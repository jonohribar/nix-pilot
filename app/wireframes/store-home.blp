using Gtk 4.0;
using Adw 1;

// nix-pilot wireframe — Software Store: home / browse
// Decision D18 groups + D16 CLI handling; layout sketch, not final design.
Adw.ApplicationWindow window {
    default-width: 1180;
    default-height: 840;
    title: "nix-pilot — Software Store";

    content: Gtk.Box {
        orientation: vertical;

        Adw.HeaderBar {
            title-widget: Gtk.Label { label: "Software"; css-classes: [ "title" ]; };
            Gtk.SearchEntry {
                hexpand: true;
                margin-start: 28;
                margin-end: 28;
                placeholder-text: "Search applications…";
            }
        }

        Gtk.Box body {
            orientation: horizontal;

            // ---- sidebar navigation
            Gtk.Box sidebar {
                orientation: vertical;
                width-request: 236;
                css-classes: [ "nav" ];
                Gtk.Label { label: "CATEGORIES"; css-classes: [ "nav-title" ]; margin-top: 14; margin-start: 14; margin-bottom: 4; }
                Gtk.Button { label: "Home"; css-classes: [ "flat", "nav-item", "active" ]; }
                Gtk.Button { label: "Applications"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Unverified"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Terminal apps"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Command-line tools"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Separator { margin-top: 10; margin-bottom: 10; }
                Gtk.Button { label: "Updates"; css-classes: [ "flat", "nav-item" ]; }
                Gtk.Button { label: "Settings"; css-classes: [ "flat", "nav-item" ]; }
            }

            // ---- main content
            Gtk.ScrolledWindow {
                vexpand: true;
                Gtk.Box main {
                    orientation: vertical;
                    margin-start: 28;
                    margin-end: 28;
                    margin-top: 18;
                    margin-bottom: 24;
                    spacing: 0;

                    Gtk.Label hero {
                        xalign: 0.0;
                        css-classes: [ "title-2" ];
                        label: "Explore 22,030 applications and tools";
                    }
                    Gtk.Label hero_sub {
                        xalign: 0.0;
                        css-classes: [ "dim-label" ];
                        label: "3,074 confirmed applications   ·   1,670 unverified   ·   289 terminal apps   ·   18,667 command-line tools";
                    }

                    Gtk.Label sec1 { label: "Featured"; css-classes: [ "heading" ]; xalign: 0.0; margin-top: 20; }
                    Gtk.FlowBox {
                        homogeneous: true;
                        max-children-per-line: 3;
                        selection-mode: none;
                        margin-top: 4;

                        Gtk.Box card1 { css-classes: [ "card" ]; orientation: vertical;
                            Gtk.Box { orientation: horizontal; spacing: 12;
                                Gtk.Box { css-classes: [ "app-icon", "class-app" ]; halign: start; valign: center;
                                    Gtk.Image { icon-name: "applications-graphics-symbolic"; pixel-size: 26; }
                                }
                                Gtk.Box { orientation: vertical; valign: center;
                                    Gtk.Label { label: "GIMP"; css-classes: [ "title" ]; xalign: 0.0; }
                                    Gtk.Label { label: "Application"; css-classes: [ "caption", "class-app" ]; xalign: 0.0; }
                                }
                            }
                            Gtk.Label { label: "GNU Image Manipulation Program — image editor"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
                        }

                        Gtk.Box card2 { css-classes: [ "card" ]; orientation: vertical;
                            Gtk.Box { orientation: horizontal; spacing: 12;
                                Gtk.Box { css-classes: [ "app-icon", "class-app" ]; halign: start; valign: center;
                                    Gtk.Image { icon-name: "applications-internet-symbolic"; pixel-size: 26; }
                                }
                                Gtk.Box { orientation: vertical; valign: center;
                                    Gtk.Label { label: "Firefox"; css-classes: [ "title" ]; xalign: 0.0; }
                                    Gtk.Label { label: "Application"; css-classes: [ "caption", "class-app" ]; xalign: 0.0; }
                                }
                            }
                            Gtk.Label { label: "Web browser built from the Firefox source tree"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
                        }

                        Gtk.Box card3 { css-classes: [ "card" ]; orientation: vertical;
                            Gtk.Box { orientation: horizontal; spacing: 12;
                                Gtk.Box { css-classes: [ "app-icon", "class-unverified" ]; halign: start; valign: center;
                                    Gtk.Image { icon-name: "applications-science-symbolic"; pixel-size: 26; }
                                }
                                Gtk.Box { orientation: vertical; valign: center;
                                    Gtk.Label { label: "WebSSH"; css-classes: [ "title" ]; xalign: 0.0; }
                                    Gtk.Label { label: "Unverified application"; css-classes: [ "caption", "class-unverified" ]; xalign: 0.0; }
                                }
                            }
                            Gtk.Label { label: "Web based SSH client — no desktop entry confirmed"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
                        }

                        Gtk.Box card4 { css-classes: [ "card" ]; orientation: vertical;
                            Gtk.Box { orientation: horizontal; spacing: 12;
                                Gtk.Box { css-classes: [ "app-icon", "class-app" ]; halign: start; valign: center;
                                    Gtk.Image { icon-name: "multimedia-player-symbolic"; pixel-size: 26; }
                                }
                                Gtk.Box { orientation: vertical; valign: center;
                                    Gtk.Label { label: "VLC"; css-classes: [ "title" ]; xalign: 0.0; }
                                    Gtk.Label { label: "Application"; css-classes: [ "caption", "class-app" ]; xalign: 0.0; }
                                }
                            }
                            Gtk.Label { label: "Media player — plays everything"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
                        }
                    }

                    Gtk.Label sec2 { label: "Terminal apps"; css-classes: [ "heading" ]; xalign: 0.0; margin-top: 22; }
                    Gtk.FlowBox {
                        homogeneous: true;
                        max-children-per-line: 3;
                        selection-mode: none;
                        margin-top: 4;

                        Gtk.Box card5 { css-classes: [ "card" ]; orientation: vertical;
                            Gtk.Box { orientation: horizontal; spacing: 12;
                                Gtk.Box { css-classes: [ "app-icon", "class-term" ]; halign: start; valign: center;
                                    Gtk.Image { icon-name: "utilities-terminal-symbolic"; pixel-size: 26; }
                                }
                                Gtk.Box { orientation: vertical; valign: center;
                                    Gtk.Label { label: "Bork"; css-classes: [ "title" ]; xalign: 0.0; }
                                    Gtk.Label { label: "Terminal app"; css-classes: [ "caption", "class-term" ]; xalign: 0.0; }
                                }
                            }
                            Gtk.Label { label: "TUI chat client for livecoding on Twitch"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
                        }

                        Gtk.Box card6 { css-classes: [ "card" ]; orientation: vertical;
                            Gtk.Box { orientation: horizontal; spacing: 12;
                                Gtk.Box { css-classes: [ "app-icon", "class-term" ]; halign: start; valign: center;
                                    Gtk.Image { icon-name: "utilities-terminal-symbolic"; pixel-size: 26; }
                                }
                                Gtk.Box { orientation: vertical; valign: center;
                                    Gtk.Label { label: "Astroterm"; css-classes: [ "title" ]; xalign: 0.0; }
                                    Gtk.Label { label: "Terminal app"; css-classes: [ "caption", "class-term" ]; xalign: 0.0; }
                                }
                            }
                            Gtk.Label { label: "Celestial viewer for the terminal"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
                        }

                        Gtk.Box card7 { css-classes: [ "card" ]; orientation: vertical;
                            Gtk.Box { orientation: horizontal; spacing: 12;
                                Gtk.Box { css-classes: [ "app-icon", "class-term" ]; halign: start; valign: center;
                                    Gtk.Image { icon-name: "utilities-terminal-symbolic"; pixel-size: 26; }
                                }
                                Gtk.Box { orientation: vertical; valign: center;
                                    Gtk.Label { label: "Tuifimanager"; css-classes: [ "title" ]; xalign: 0.0; }
                                    Gtk.Label { label: "Terminal app"; css-classes: [ "caption", "class-term" ]; xalign: 0.0; }
                                }
                            }
                            Gtk.Label { label: "Terminal-based file manager for Android tools"; css-classes: [ "desc" ]; xalign: 0.0; wrap: true; margin-top: 10; }
                        }
                    }
                }
            }
        }
    };
}
