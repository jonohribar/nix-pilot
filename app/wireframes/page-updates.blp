using Gtk 4.0;
using Adw 1;

// Updates / Recovery — system change as a transaction (failure-and-recovery.md):
// pending items -> plain-language summary -> apply -> progress -> rollback.
// Structural draft; failure and boot-recovery states come next pass.
Gtk.Box page_updates {
    orientation: vertical;
    margin-start: 28;
    margin-end: 28;
    margin-top: 18;

    Gtk.Label h { label: "Updates"; css-classes: [ "title-2" ]; xalign: 0.0; }
    Gtk.Label s {
        label: "Changes are prepared first, then applied as one unit — if anything fails, the system stays as it was";
        css-classes: [ "dim-label" ];
        xalign: 0.0;
        wrap: true;
        margin-bottom: 12;
    }

    Gtk.Box card_pending { css-classes: [ "card" ]; orientation: vertical; spacing: 6; margin-bottom: 8;
        Gtk.Label { label: "Ready to update"; css-classes: [ "heading" ]; xalign: 0.0; }
        Gtk.Box { orientation: horizontal; spacing: 12;
            Gtk.Image { icon-name: "software-update-available-symbolic"; pixel-size: 20; }
            Gtk.Label { label: "Firefox 160.0 · 6 other applications"; xalign: 0.0; hexpand: true; }
            Gtk.Label { label: "48 MB"; css-classes: [ "dim-label" ]; }
        }
        Gtk.Box { orientation: horizontal; spacing: 12;
            Gtk.Image { icon-name: "system-software-update-symbolic"; pixel-size: 20; }
            Gtk.Label { label: "System – 1 change (kernel update)"; xalign: 0.0; hexpand: true; }
            Gtk.Label { label: "310 MB"; css-classes: [ "dim-label" ]; }
        }
    }

    Gtk.Button btn_apply {
        label: "Prepare and install changes";
        css-classes: [ "suggested-action" ];
        halign: start;
        margin-bottom: 10;
    }

    Gtk.Box card_txn { css-classes: [ "card" ]; orientation: vertical; spacing: 2;
        Gtk.Label { label: "How it works"; css-classes: [ "heading" ]; xalign: 0.0; }
        Gtk.Label { label: "1. Prepare — changes are built and checked"; css-classes: [ "dim-label" ]; xalign: 0.0; wrap: true; }
        Gtk.Label { label: "2. Summary — you see what will change, in plain language"; css-classes: [ "dim-label" ]; xalign: 0.0; wrap: true; }
        Gtk.Label { label: "3. Apply — the system switches over"; css-classes: [ "dim-label" ]; xalign: 0.0; wrap: true; }
        Gtk.Label { label: "4. If it fails — you can go back to yesterday's system"; css-classes: [ "dim-label" ]; xalign: 0.0; wrap: true; }
    }

    Gtk.Label note {
        label: "Rollback and boot-time recovery are covered in the failure-handling spec";
        css-classes: [ "dim-label" ];
        xalign: 0.0;
        margin-top: 10;
    }
}
