# List all recipes with their descriptions
help:
    @just --list

# interactive dev shell (cargo + GTK4 + libadwaita + wireframe tools)
shell:
    nix-shell ./shell.nix

# compile the GTK4 + libadwaita Rust client
build:
    @if command -v cargo >/dev/null 2>&1; then cargo build; else nix-shell ./shell.nix --run 'cargo build'; fi

# run the store client against the local catalogue index
run: build
    @if command -v cargo >/dev/null 2>&1; then cargo run --bin nix-pilot-app; else nix-shell ./shell.nix --run 'cargo run --bin nix-pilot-app'; fi

# run the clickable wireframe prototype (page-*.blp shell)
proto: build
    @if command -v cargo >/dev/null 2>&1; then cargo run --bin proto; else nix-shell ./shell.nix --run 'cargo run --bin proto'; fi

# generate and validate internal Rust API documentation in target/doc
docs:
    @if command -v cargo >/dev/null 2>&1; then RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --document-private-items; else nix-shell ./shell.nix --run 'RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --document-private-items'; fi

# render wireframe states to PNGs (all, or named: detail search …)
wireframes *states: build
    @if command -v blueprint-compiler >/dev/null 2>&1; then ./wireframes/render.sh {{states}}; else nix-shell ./shell.nix --run './wireframes/render.sh {{states}}'; fi

# headless smoke test (xvfb, ~5 s)
smoke: build
    @if command -v xvfb-run >/dev/null 2>&1 && command -v xwininfo >/dev/null 2>&1; then ./scripts/smoke.sh; else nix-shell ./shell.nix --run './scripts/smoke.sh'; fi

# Activation harness: prove switch+rollback in an isolated QEMU VM
# (uses the NixOS test driver; never touches the host config or system; qemu
# stays out of the main dev shell)
# Installed-module harness: proves polkit pkexec authorizes the helper
# and the area gets published (isolated QEMU VM; does not switch the host)
vm-apply:
    @if command -v qemu-system-x86_64 >/dev/null 2>&1; then ./scripts/vm-apply-test.sh; else nix-shell -p qemu openssh --run './scripts/vm-apply-test.sh'; fi

vm-probe:
    @if command -v qemu-system-x86_64 >/dev/null 2>&1; then ./scripts/vm-activation-test.sh; else nix-shell -p qemu openssh --run './scripts/vm-activation-test.sh'; fi

# Packaging check: the nix-pilot NixOS module must evaluate when enabled
module-check:
    @if command -v nix-instantiate >/dev/null 2>&1; then ./scripts/module-check.sh; else nix-shell ./shell.nix --run './scripts/module-check.sh'; fi

# AT-SPI integration tests (headless, accessibility-tree driven)
# Each test runs inside one dbus-run-session (see run-test.sh) so the a11y
# client, launcher, and app share a single session bus.
atspi-test: build
    @nix-shell ./test-atspi.nix --run 'bash ./scripts/a11y/run-test.sh ./scripts/a11y/test_nav_settings.py ./target/debug/nix-pilot-app && bash ./scripts/a11y/run-test.sh ./scripts/a11y/test_search.py ./target/debug/nix-pilot-app'

# fmt + clippy + tests gate (run before committing)
check:
    @if command -v cargo >/dev/null 2>&1; then cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test; else nix-shell ./shell.nix --run 'cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test'; fi